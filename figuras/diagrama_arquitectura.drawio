        <mxCell id="N-c-3SJSqPy-bYsGvBhw-69" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=20;" value="&lt;div&gt;Distribución de claves: slot = CRC16(clave) mod 16384&lt;/div&gt;&lt;div&gt;Ejemplo real: usuario:25 → slot 7554 → Maestro B (172.30.0.12)&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="510" x="40" y="650" as="geometry" />
